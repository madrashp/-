@startuml
title E-Library System — Бізнес-процес видачі та повернення книги (Activity Diagram)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam conditionStyle diamond
skinparam activityFontSize 12

|User|
start
:Натискає "Забронювати книгу"\n(bookId);

|E-Library System|
:Отримує POST /api/v1/loans;
:Перевіряє наявність боргів\n(returned_at IS NULL AND\ndue_date < NOW());

if (Є прострочені Loan?\n[ADR 0002]) then (так)
  :Формує помилку\nHTTP 403 Forbidden;
  :Надсилає повідомлення про блокування; <<output>>
  |User|
  :Отримує сповіщення про блокування; <<input>>
  stop
else (ні)
  |E-Library System|
  :Перевіряє доступність книги\n(Book.is_available);
  if (Книга доступна?) then (ні)
    :Формує помилку\nHTTP 409 Conflict;
    :Надсилає повідомлення про відсутність; <<output>>
    |User|
    :Отримує сповіщення: книга недоступна; <<input>>
    stop
  else (так)
    |E-Library System|
    :Створює запис Loan\n(status = PENDING,\ndue_date = +14 днів);
    
    fork
      :Оновлює статус книги\n(Book.is_available = false);
    fork again
      :Формує квитанцію\nбронювання (HTTP 201);
    end fork
    
    :Надсилає підтвердження бронювання; <<output>>
    |User|
    :Отримує підтвердження та забирає книгу; <<input>>
  endif
endif

|E-Library System|
:Очікує повернення книги\nдо настання due_date;

if (Термін due_date минув,\nа returned_at IS NULL?) then (так (прострочено))
  :Делегує нагадування (UC-10); <<output>>
  |Notification Service <<System>>|
  :Отримує тригер про борг; <<input>>
  :Надсилає email-нагадування читачеві; <<output>>
  |User|
  :Отримує лист-нагадування про борг; <<input>>
  note right
    Процес не блокується без відповіді:
    Loan лишається простроченим (блокує
    нові видачі) до фізичного повернення.
  end note
else (ні (вчасно))
endif

|User|
:Приносить книгу до бібліотеки;

|Librarian|
:Фізично приймає книгу;
:Підтверджує повернення\nв системі (UC-09);

|E-Library System|
:Оновлює запис Loan\n(returned_at = NOW());
:Звільняє книгу\n(Book.is_available = true);
:Надсилає повідомлення про закриття видачі; <<output>>

|User|
:Отримує підтвердження закриття Loan; <<input>>
stop

@enduml
